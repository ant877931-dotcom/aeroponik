# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development.
# NEVER commit `.env` to version control — add it to .gitignore.
# On Render / Railway, set these as Environment Variables in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# The port Uvicorn listens on.
# PaaS platforms (Render, Railway, Heroku) inject $PORT automatically —
# you don't need to set this yourself in production.
PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use "*" only during local development.
# In production: set this to your exact Vercel URL.
#
# Example:
#   ALLOWED_ORIGINS=https://aeroponik.vercel.app,https://www.aeroponik.vercel.app
ALLOWED_ORIGINS=*

# ── Model (optional overrides) ────────────────────────────────────────────────
# These match the defaults in inference.py but can be tuned per-environment.

# Minimum confidence score (0.0–1.0) for a detection to be reported.
# CONFIDENCE_THRESHOLD=0.35

# Maximum number of concurrent inference threads.
# Keep at 1 for single-GPU or CPU-only hosts.
# MAX_WORKERS=1
